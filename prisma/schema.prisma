generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SellLeadStatus {
  NEW
  CONTACTED
  EVALUATING
  CLOSED
  ARCHIVED
}

enum SellLeadIntent {
  DIRECT_SALE
  CONSIGNMENT
  EVALUATE_BOTH
  PURCHASE
  FINANCING_INTEREST
  CONTACT_REQUEST
}

enum SellLeadChannel {
  UNDEFINED
  WHATSAPP
  PHONE
  IN_PERSON
  EMAIL
}

enum VehicleType {
  CAR
  MOTORCYCLE
  ELECTRIC_BIKE
}

enum VehicleCondition {
  NEW
  USED
}

enum CommercialEventType {
  VEHICLE_VIEW
  WHATSAPP_CLICK
  FINANCING_INTEREST
  SELL_LEAD_SUBMITTED
  CONTACT_INTENT
  PURCHASE_INTENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]
  cartItems CartItem[]
}

model Brand {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  cars Car[]
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  cars Car[]
}

model Car {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  price        Float
  purchasePrice Float?
  fipePrice    Float?
  year         Int
  mileage      Int?
  fuelType     String?
  transmission String?
  color        String?
  doors        Int?
  capacity     Int?
  location     String?
  features     String[] @default([])
  vehicleType  VehicleType      @default(CAR)
  condition    VehicleCondition @default(USED)
  isSold       Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isPromotion  Boolean  @default(false)
  promotionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images    CarImage[]
  favorites Favorite[]
  cartItems CartItem[]
  sellLeads SellLead[]
  commercialEvents CommercialEvent[]
}

model CarImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  carId     String
  car       Car     @relation(fields: [carId], references: [id])

  @@index([carId])
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  carId  String
  user   User   @relation(fields: [userId], references: [id])
  car    Car    @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
}

model SellLead {
  id           String         @id @default(cuid())
  name         String
  email        String
  phone        String?
  vehicleModel String
  year         Int?
  mileage      Int?
  notes        String?
  intent       SellLeadIntent @default(DIRECT_SALE)
  status       SellLeadStatus @default(NEW)
  contactChannel SellLeadChannel @default(UNDEFINED)
  nextActionAt DateTime?
  adminNotes   String?
  closedAt     DateTime?
  consent      Boolean        @default(false)
  consentAt    DateTime?
  sourcePath   String?
  sourceType   String?
  vehicleSlug  String?
  carId        String?
  car          Car?           @relation(fields: [carId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  commercialEvents CommercialEvent[]

  @@index([status, createdAt])
  @@index([contactChannel, nextActionAt])
  @@index([email])
  @@index([sourcePath, createdAt])
  @@index([vehicleSlug, createdAt])
  @@index([carId, createdAt])
}

model CartItem {
  id      String   @id @default(cuid())
  userId  String
  carId   String
  user    User     @relation(fields: [userId], references: [id])
  car     Car      @relation(fields: [carId], references: [id])
  addedAt DateTime @default(now())

  @@unique([userId, carId])
}

model CommercialEvent {
  id           String              @id @default(cuid())
  type         CommercialEventType
  channel      SellLeadChannel     @default(UNDEFINED)
  sourcePath   String
  ctaLabel     String?
  vehicleSlug  String?
  vehicleTitle String?
  metadata     Json?
  carId        String?
  car          Car?                @relation(fields: [carId], references: [id])
  leadId       String?
  lead         SellLead?           @relation(fields: [leadId], references: [id])
  createdAt    DateTime            @default(now())

  @@index([type, createdAt])
  @@index([channel, createdAt])
  @@index([sourcePath, createdAt])
  @@index([vehicleSlug, createdAt])
  @@index([carId, createdAt])
  @@index([leadId, createdAt])
}
